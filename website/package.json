{
  "name": "@farming-labs/docs-website",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "farm dev",
    "build": "pnpm prisma generate && pnpm run build:packages && pnpm run build:app",
    "build:packages": "pnpm --filter @farming-labs/docs build && pnpm --filter @farming-labs/theme build && pnpm --filter @farming-labs/farmjs build",
    "build:app": "farm build",
    "start": "farm start",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@databuddy/sdk": "^2.3.29",
    "@farm.js/core": "^0.1.21",
    "@farming-labs/docs": "workspace:*",
    "@farming-labs/farmjs": "workspace:*",
    "@farming-labs/theme": "workspace:*",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "afdocs": "^0.18.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "geist": "^1.7.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.564.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sugar-high": "^0.9.5",
    "tailwind-merge": "^3.0.2",
    "unicornstudio-react": "latest"
  },
  "devDependencies": {
    "@farm.js/cli": "^0.1.21",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  }
}
