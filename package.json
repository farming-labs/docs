{
  "name": "@farming-labs/docs-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm --filter @farming-labs/docs run build && pnpm --filter @farming-labs/theme run build && pnpm --filter './packages/*' --filter '!@farming-labs/docs' --filter '!@farming-labs/theme' run build",
    "try:init": "pnpm --filter @farming-labs/docs run build && cd examples/next && node ../../packages/docs/dist/cli/index.mjs init",
    "dev": "pnpm --filter example-next dev",
    "examples:version": "node scripts/set-examples-version.mjs",
    "mcp:conformance": "node scripts/run-mcp-conformance.mjs",
    "smoke:agent-surfaces": "node scripts/smoke-agent-surfaces.mjs",
    "start:mcp-conformance-server": "node scripts/mcp-conformance-server.mjs",
    "test:mcp-conformance-runner": "node --test scripts/mcp-conformance.test.mjs",
    "test:smoke-agent-surfaces": "node --test scripts/smoke-agent-surfaces.test.mjs",
    "test": "pnpm --filter @farming-labs/docs run test",
    "typecheck": "pnpm --filter @farming-labs/docs run build && pnpm --filter './packages/*' run typecheck",
    "release": "bumpp",
    "release:latest": "bumpp --tag latest && pnpm --filter './packages/*' publish --access public --tag latest --no-git-checks",
    "release:beta": "bumpp --preid beta",
    "publish:beta": "pnpm --filter './packages/*' publish --access public --tag beta --no-git-checks",
    "publish:latest": "pnpm --filter './packages/*' publish --access public --no-git-checks",
    "lint": "oxlint .",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check .",
    "lint:fix": "oxlint --fix ."
  },
  "devDependencies": {
    "@farming-labs/docs": "workspace:*",
    "@farming-labs/next": "workspace:*",
    "@farming-labs/theme": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "bumpp": "^10.4.1",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.1.18",
    "three": "^0.180.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "defu@<=6.1.4": "6.1.5",
      "next": "16.2.11",
      "astro": "6.4.8",
      "@sveltejs/kit": "^2.57.1",
      "h3": "^1.15.6",
      "effect": "^3.20.0",
      "esbuild@>=0.17.0 <0.28.1": "0.28.1",
      "devalue": "5.8.1",
      "node-forge": "^1.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16",
      "nuxt@>=3.21.7 <3.21.10": "3.21.11",
      "@nuxt/devtools@<3.3.1": "3.4.1",
      "path-to-regexp@>=4.0.0 <6.3.0": "6.3.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "basic-ftp": "5.3.1",
      "lodash": "4.18.1",
      "simple-git": "^3.36.0",
      "serialize-javascript": "^7.0.3",
      "shell-quote@<=1.8.4": "1.9.0",
      "svgo": "^4.0.2",
      "fast-uri": "3.1.5",
      "sharp": "0.35.3",
      "hono": "4.12.25",
      "rollup": "^4.59.0",
      "tar": "^7.5.22",
      "undici": "7.29.0",
      "postcss@<=8.5.17": "8.5.18",
      "seroval@<=1.5.2": "1.5.3",
      "ip-address@<=10.3.0": "10.4.0",
      "ws": "^8.21.0",
      "@farm.js/core>vite": "6.4.3",
      "readdir-glob>minimatch": "10.2.4",
      "glob@10>minimatch": "10.2.4",
      "glob@13>minimatch": "^10.2.3"
    }
  }
}
